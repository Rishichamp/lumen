# Copy to .env and fill in real values. Never commit .env.

ENV=development
DEBUG=true

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-random-64-char-hex-string

# Local dev default (sqlite). Production example:
# DATABASE_URL=postgresql+psycopg2://lumen:lumen@postgres:5432/lumen
DATABASE_URL=sqlite:///./lumen.db

CORS_ORIGINS=["http://localhost:3000"]

UPLOAD_DIR=./storage/uploads
VECTOR_INDEX_DIR=./storage/vector_indexes

# Leave OPENAI_API_KEY empty to run in extractive-fallback mode (no
# generated answers, but the full pipeline — upload, embed, retrieve,
# cite — still works end to end for local dev/testing).
LLM_PROVIDER=openai
OPENAI_API_KEY=

# ---- Option A: OpenAI (paid, no free tier) ----
# OPENAI_BASE_URL=                      (leave empty)
# OPENAI_CHAT_MODEL=gpt-5.6-terra        (balanced cost/quality; see
#                                          platform.openai.com/docs/pricing)

# ---- Option B: Groq (free, no credit card, OpenAI-compatible) ----
# Get a key at console.groq.com (email sign-up, no card required), then:
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_CHAT_MODEL=openai/gpt-oss-120b

OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-5.6-terra
